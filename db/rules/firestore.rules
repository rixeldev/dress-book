rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /regs/{regId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /version/{versionId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Organization members: a member can read their own membership doc and
    // the owner can manage the list.
    match /users/{uid}/orgMembers/{memberUid} {
      allow read: if isOwner(uid) || request.auth.uid == memberUid;
      allow create: if signedIn() && request.auth.uid == memberUid;
      allow delete: if isOwner(uid) || request.auth.uid == memberUid;
    }

    // Suggestions submitted by members and reviewed by the owner.
    match /users/{uid}/suggestions/{suggestionId} {
      allow read: if isOwner(uid) || resource.data.memberUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.memberUid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(uid)/orgMembers/$(request.auth.uid));
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // Public organization directory (only when owner opts in).
    match /publicOrgs/{orgId} {
      allow read: if signedIn();
      allow write: if isOwner(orgId);
    }

    // Join requests submitted by members to an owner.
    match /users/{uid}/joinRequests/{requestId} {
      allow read: if isOwner(uid) || (signedIn() && requestId == request.auth.uid);
      allow create: if signedIn() && requestId == request.auth.uid;
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid) || (signedIn() && requestId == request.auth.uid);
    }
      allow read: if isOwner(uid)
        || exists(/databases/$(database)/documents/users/$(uid)/orgMembers/$(request.auth.uid));
      allow write: if isOwner(uid);
    }
  }
}
